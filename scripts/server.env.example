# Settings of the compute server for the launch scripts. Copy this file to
# scripts/server.env, which is not tracked, and fill it in, or export the variables.
# Root of the repository on the server.
ECHOLABEL_REPO_DIR=/path/to/repository
# Read-only data roots: the echosounder store with the camera transects, and the annotations.
ECHOLABEL_SOURCE_DATA=/path/to/source_data
ECHOLABEL_ANNOTATED_DATA=/path/to/annotated_data
# Derived tables, logs and weights, and the large products that can be regenerated.
ECHOLABEL_PROJECT_DIR=/path/to/project_dir
ECHOLABEL_SCRATCH_DIR=/path/to/scratch_dir
# Conda environment of the pipeline, as a prefix or a name.
ECHOLABEL_CONDA_ENV=/path/to/conda/env
# Paths file passed to every stage, relative to the repository.
ECHOLABEL_PATHS=configs/paths/server.yaml
# Login of the server, used by the scripts that run on the development machine.
ECHOLABEL_REMOTE=user@host
